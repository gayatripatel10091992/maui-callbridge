<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:CallBridge.Core;assembly=CallBridge.Core"
             xmlns:vm="clr-namespace:CallBridge.Core.ViewModels;assembly=CallBridge.Core"
             x:Class="CallBridge.Maui.Pages.PlansPage"
             x:DataType="vm:PlansViewModel"
             Title="Plans">

    <CollectionView ItemsSource="{Binding Cards}" SelectionMode="None" Margin="16,0">
        <CollectionView.Header>
            <VerticalStackLayout Spacing="6" Padding="0,8,0,12">
                <Label Text="Pick the plan that fits how you call" FontSize="22" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#111827, Dark=#F3F4F6}" />
                <Label Text="{Binding EntitlementLabel}" Style="{StaticResource Secondary}" />
                <Label Text="{Binding Message}" Style="{StaticResource Secondary}" TextColor="{StaticResource Primary}" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="core:PlanCard">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" StrokeThickness="0">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Emphasised}" Value="True">
                            <Setter Property="StrokeThickness" Value="2" />
                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                            <Label Grid.Column="0" Text="{Binding Name}" FontSize="20" TextColor="{AppThemeBinding Light=#111827, Dark=#F3F4F6}" />
                            <Label Grid.Column="1" Text="{Binding Price}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111827, Dark=#F3F4F6}" />
                            <Label Grid.Column="2" Text="{Binding PeriodLabel}" Style="{StaticResource Secondary}" VerticalOptions="End" />
                        </Grid>
                        <Label Text="Selected on the web" IsVisible="{Binding Highlighted}" FontSize="12" TextColor="{StaticResource Primary}" />
                        <Label Text="{Binding FeaturesText}" Style="{StaticResource Primary}" FontSize="14" LineHeight="1.3" />
                        <Button Text="{Binding ActionLabel}" IsEnabled="{Binding ActionEnabled}" Clicked="OnSelectClicked" Style="{StaticResource Filled}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.Footer>
            <Label Padding="0,4,0,24" Style="{StaticResource Secondary}"
                   Text="Subscriptions renew automatically through your app store until cancelled. Upgrades are charged a prorated amount now; downgrades start at your next renewal." />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>
